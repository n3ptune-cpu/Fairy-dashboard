# /etc/systemd/system/fairy.service
[Unit]
Description=Fairy homelab panel
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# Static binary: /usr/local/bin/fairy. Behind nginx on 127.0.0.1:8080.
ExecStart=/usr/local/bin/fairy serve --config /etc/fairy/config.yaml --env-file /etc/fairy/fairy.env --listen 127.0.0.1:8080
# Secrets: systemd reads this file as root, so it can stay 0600 root:root.
EnvironmentFile=/etc/fairy/fairy.env
# Run as a dedicated system user (useradd --system --home /var/lib/fairy --shell /usr/sbin/nologin fairy),
# so `fairy admin` can be run as the same user: sudo -u fairy fairy admin ...
User=fairy
Group=fairy
StateDirectory=fairy
StateDirectoryMode=0700
ConfigurationDirectory=fairy
UMask=0077
Restart=on-failure
RestartSec=5

# Hardening. The panel only talks HTTP(S)/TCP to Proxmox, agents, plugs, BMCs and NUT; it needs NO capabilities
# (power control goes through agents or the Proxmox API, never local commands).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/fairy
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# In an unprivileged LXC without nesting, namespace-based options can fail with status=226/NAMESPACE:
# then comment out PrivateTmp/PrivateDevices/Protect*/ProcSubset.

[Install]
WantedBy=multi-user.target
