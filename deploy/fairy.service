# /etc/systemd/system/fairy.service
[Unit]
Description=Fairy homelab panel
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# Static binary: /usr/local/bin/fairy. The listen address comes from `listen:` in config.yaml (default
# 127.0.0.1:8080; with nginx in another container use this LXC's LAN address, e.g. 10.0.0.20:8080, and allow
# only nginx to reach it: see IPAddressAllow below or nftables).
# --env-file "": the secrets come from EnvironmentFile= below; the service user cannot (and need not) read it.
ExecStart=/usr/local/bin/fairy serve --config /etc/fairy/config.yaml --env-file ""
# Secrets: systemd reads this file as root before dropping privileges, so it stays 0600 root:root.
EnvironmentFile=/etc/fairy/fairy.env
# Run as a dedicated system user (useradd --system --home /var/lib/fairy --shell /usr/sbin/nologin fairy).
# Run `fairy admin` as the same user: sudo -u fairy fairy admin ...  (commands that change something refuse to
# run as root, so they cannot leave files in /var/lib/fairy that the service can no longer read).
# /etc/fairy: 0750 root:fairy (only root and the service user may enter). config.yaml: 0640 root:fairy.
# fairy.env: 0600 root:root (read by systemd, never by the service).
User=fairy
Group=fairy
StateDirectory=fairy
StateDirectoryMode=0700
ConfigurationDirectory=fairy
# /etc/fairy is 0750 root:fairy; without this systemd warns that it differs from the default 0755.
ConfigurationDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=5
# Memory ceiling. The panel bounds what it keeps from every machine it reads; should that ever fail (a monitored
# machine sending absurd answers), the kernel stops the panel at this limit and systemd starts it again (Restart=
# above), instead of the panel taking the memory of everything else on this host.
# `fairy update` replaces only the binary, never this file. On an install made before this line existed, add it
# once by hand:
#   sudo systemctl edit fairy        (write the two lines "[Service]" and "MemoryMax=512M", save)
#   sudo systemctl restart fairy
# and check it with: systemctl show fairy -p MemoryMax    (536870912 = 512M)
MemoryMax=512M

# Hardening. The panel only talks HTTP(S)/TCP to Proxmox, agents, plugs, BMCs and NUT; it needs NO capabilities
# (power control goes through agents or the Proxmox API, never local commands).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/fairy
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Network allow-list (needs cgroup BPF; in an unprivileged LXC use nftables instead): nginx, the tailnet, Pocket ID.
# IPAddressDeny=any
# IPAddressAllow=localhost 10.0.0.5 100.64.0.0/10 10.0.0.30
# Proxmox: an unprivileged LXC needs `features: nesting=1` (pct set <vmid> --features nesting=1, or Options ->
# Features -> Nesting in the UI, then restart the container) for this sandboxing; without it the namespace-based
# options fail with status=226/NAMESPACE. If nesting is not an option, comment out
# PrivateTmp/PrivateDevices/Protect*/ProcSubset instead.

[Install]
WantedBy=multi-user.target
