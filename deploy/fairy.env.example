# /etc/fairy/fairy.env  (mode 0600, owner root; read by systemd before the service drops privileges)
# Placeholders only. Generate real values, e.g.: openssl rand -base64 48
FAIRY_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# FAIRY_OIDC_CLIENT_SECRET=REPLACE_ME            # omit for a Pocket ID public client (PKCE only)
FAIRY_PROXMOX_TOKEN_SECRET=REPLACE_ME
AGENT_TOKEN_NSX_CYRENE=REPLACE_WITH_AT_LEAST_24_CHARACTERS
# FAIRY_NOTIFY_URL=https://ntfy.sh/your-private-topic   # or a Discord webhook URL; https only
# FAIRY_INSECURE_COOKIES=1                       # local http testing ONLY
