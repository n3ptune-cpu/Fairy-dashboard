# /etc/fairy/fairy.env  (mode 0600, owner root; read by systemd's EnvironmentFile= before the service drops
# privileges; the unit passes --env-file "" so Fairy itself does not try to read it)
# Placeholders only. Generate real values, e.g.: openssl rand -base64 48
# The panel does not start while FAIRY_SESSION_SECRET is the line below (or one character repeated), and
# `fairy admin config check` says so: the value signs the session cookies and this file is public.
FAIRY_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FAIRY_PROXMOX_TOKEN_SECRET=REPLACE_ME
AGENT_TOKEN_AGENT_1=REPLACE_WITH_AT_LEAST_24_CHARACTERS
#
# Optional lines. To use one, remove the "# " in front of it. Every comment here is on a line of its own:
# nothing may follow a value, because systemd and Fairy read "VALUE   # comment" as one value, comment included.
#
# Pocket ID client secret. Leave the line out for a public client (PKCE only).
# FAIRY_OIDC_CLIENT_SECRET=REPLACE_ME
#
# Push notifications: an ntfy topic, or a Discord webhook URL. https only.
# FAIRY_NOTIFY_URL=https://ntfy.sh/your-private-topic
#
# Local http testing ONLY: the session cookie is then not Secure.
# FAIRY_INSECURE_COOKIES=1
